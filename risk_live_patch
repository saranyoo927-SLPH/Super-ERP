// ============================================================
// 1. LOAD RISK DATA FROM GAS
// ============================================================
async function loadRiskFromGAS() {
    var gasUrl = (typeof GS_WEB_APP_URL !== 'undefined') ? GS_WEB_APP_URL : null;

    // Layer 1: GAS Web App (?action=risk)
    if (gasUrl) {
        try {
            console.log('🔄 Risk: loading from GAS Web App...');
            var resp = await fetch(gasUrl + '?action=risk', { redirect: 'follow' });
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            var json = await resp.json();

            if (json && json.monthly && json.monthly.length > 0) {
                riskLiveData = json;
                console.log('✅ Risk GAS loaded:', json.monthly.length, 'months',
                    json.annual ? ', ' + json.annual.length + ' years' : '',
                    json.latest ? ', latest riskScore=' + json.latest.riskScore : '');
                applyRiskLiveData(json);
                return;
            } else if (json && json.error) {
                console.warn('⚠ Risk GAS error:', json.error);
            }
        } catch (e) {
            console.warn('⚠ Risk GAS failed:', e.message);
        }
    }

    // Layer 2: gviz (public sheet fallback)
    var sheetId = '1sjKjR2XH568haiMSMnPo1k8RSYAjp3ocmvu7e5sgAB0';
    try {
        console.log('🔄 Risk: loading from gviz...');
        var url = 'https://docs.google.com/spreadsheets/d/' + sheetId + '/gviz/tq?tqx=out:json';
        var resp2 = await fetch(url);
        var text = await resp2.text();
        var json2 = JSON.parse(text.substring(47).slice(0, -2));
        var rows = json2.table.rows;

        if (rows && rows.length > 1) {
            var monthly = [];
            for (var i = 1; i < rows.length; i++) {
                var c = rows[i].c;
                if (!c || !c[0]) continue;
                var m = String(c[0].v || '').trim();
                if (!m) continue;
                monthly.push({
                    month: m,
                    currentRatio: c[1] ? parseFloat(c[1].v) || 0 : 0,
                    quickRatio:   c[2] ? parseFloat(c[2].v) || 0 : 0,
                    cashRatio:    c[3] ? parseFloat(c[3].v) || 0 : 0,
                    nwc:          c[4] ? parseFloat(c[4].v) || 0 : 0,
                    niDep:        c[5] ? parseFloat(c[5].v) || 0 : 0,
                    ebitda:       c[6] ? parseFloat(c[6].v) || 0 : 0,
                    netCash:      c[7] ? parseFloat(c[7].v) || 0 : 0,
                    riskScore:    c[11] ? parseFloat(c[11].v) || 0 : 0
                });
            }
            if (monthly.length > 0) {
                riskLiveData = { monthly: monthly, latest: monthly[monthly.length - 1] };
                console.log('✅ Risk gviz loaded:', monthly.length, 'months');
                applyRiskLiveData(riskLiveData);
                return;
            }
        }
    } catch (e2) {
        console.warn('⚠ Risk gviz failed:', e2.message);
    }

    // Layer 3: hardcoded
    console.log('Risk: using hardcoded fallback');
}

// ============================================================
// 2. APPLY RISK LIVE DATA
// ============================================================
function applyRiskLiveData(data) {
    if (!data || !data.monthly || data.monthly.length === 0) return;

    var monthly = data.monthly;
    var annual = data.annual || RISK_FALLBACK.annual;
    var latest = data.latest || monthly[monthly.length - 1];

    // ── KPI Cards ──
    var panel = document.getElementById('risk-ov');
    if (panel) {
        var cards = panel.querySelectorAll('.nt-kpi');
        var cardData = [
            {
                label: 'Risk Score (' + latest.month + ')',
                val: latest.riskScore + ' <small>/ 6</small>',
                foot: getRiskLabel(latest.riskScore),
                pill: getRiskPill(latest.riskScore),
                color: latest.riskScore <= 2 ? 'c-green' : latest.riskScore <= 3 ? 'c-amber' : 'c-red'
            },
            {
                label: 'Current Ratio (' + latest.month + ')',
                val: (latest.currentRatio || 0).toFixed(2) + ' <small>เท่า</small>',
                foot: 'ค่ากลาง 1.5 | ' + (latest.currentRatio >= 1.5 ? 'ผ่าน' : 'ต่ำกว่า'),
                pill: latest.currentRatio >= 1.5 ? 'ผ่านเกณฑ์' : 'ต่ำกว่าเกณฑ์',
                color: latest.currentRatio >= 1.5 ? 'c-green' : 'c-blue'
            },
            {
                label: 'Quick Ratio (' + latest.month + ')',
                val: (latest.quickRatio || 0).toFixed(2) + ' <small>เท่า</small>',
                foot: 'ค่ากลาง 1.0 | ' + (latest.quickRatio >= 1.0 ? 'ผ่าน' : 'ต่ำกว่า'),
                pill: latest.quickRatio >= 1.0 ? 'ผ่านเกณฑ์' : 'ต่ำกว่าเกณฑ์',
                color: latest.quickRatio >= 1.0 ? 'c-green' : 'c-blue'
            },
            {
                label: 'Cash Ratio (' + latest.month + ')',
                val: (latest.cashRatio || 0).toFixed(2) + ' <small>เท่า</small>',
                foot: 'ค่ากลาง 0.8 | ' + (latest.cashRatio >= 0.8 ? 'ผ่าน' : 'ต่ำกว่ามาก'),
                pill: latest.cashRatio >= 0.8 ? 'ผ่านเกณฑ์' : 'ต่ำมาก',
                color: latest.cashRatio >= 0.8 ? 'c-green' : 'c-amber'
            },
            {
                label: 'NWC (' + latest.month + ')',
                val: (latest.nwc || 0).toFixed(2) + ' <small>M\u0E3F</small>',
                foot: (latest.nwc >= 0 ? 'เป็นบวก ✓' : 'ติดลบ ⚠'),
                pill: latest.nwc >= 0 ? 'บวก ✓' : 'ติดลบ ⚠',
                color: latest.nwc >= 0 ? 'c-green' : 'c-red'
            },
            {
                label: 'เงินบำรุงคงเหลือสุทธิ',
                val: (latest.netCash || 0).toFixed(2) + ' <small>M\u0E3F</small>',
                foot: latest.month + ' | ' + (latest.netCash >= 0 ? 'เป็นบวก' : 'ติดลบ'),
                pill: latest.netCash >= 0 ? 'บวก ✓' : 'ติดลบ ⚠',
                color: latest.netCash >= 0 ? 'c-green' : 'c-red'
            }
        ];

        cardData.forEach(function(cd, i) {
            if (i >= cards.length) return;
            var card = cards[i];
            var lblEl = card.querySelector('.nt-lbl');
            var valEl = card.querySelector('.nt-val');
            var footEl = card.querySelector('.nt-foot');
            var pillEl = card.querySelector('.nt-pill');

            if (lblEl) lblEl.textContent = cd.label;
            if (valEl) valEl.innerHTML = cd.val;
            if (footEl) footEl.textContent = cd.foot;
            if (pillEl) {
                pillEl.textContent = cd.pill;
                var pClass = 'nt-pill ';
                if (cd.color === 'c-green') pClass += 'good';
                else if (cd.color === 'c-red') pClass += 'bad';
                else pClass += 'warn';
                pillEl.className = pClass;
            }
            card.className = 'nt-kpi ' + cd.color;
        });
    }

    // ── Insight Box ──
    var insightEl = document.querySelector('#risk-ov .nt-insight');
    if (insightEl && monthly.length > 0) {
        var scores = monthly.map(function(m) { return m.riskScore; });
        var months = monthly.map(function(m) { return m.month; });
        var allSame = scores.every(function(s) { return s === scores[0]; });
        var msg = '';
        if (allSame) {
            msg = '<strong>⚠ Risk Score ระดับ ' + scores[0] + ' ทุกเดือน ' + months[0] + '–' + months[months.length-1] + '</strong>';
        } else {
            msg = '<strong>📊 Risk Score ' + months[0] + '–' + months[months.length-1] + ':</strong> ' +
                  monthly.map(function(m) { return m.month + '=' + m.riskScore; }).join(', ');
        }
        insightEl.innerHTML = msg;
    }

    // ── Section header ──
    var sHead = document.querySelector('#tab-risk-score .erp-section-head h3');
    if (sHead) sHead.textContent = '🏦 Risk Scoring Dashboard • รพ.เสลภูมิ (Live Data)';

    // ── Re-render charts ──
    renderRiskChartsFromData(monthly, annual);

    // ── ERP Overview card ──
    updateERPOverviewRisk(latest);

    console.log('✅ Risk Dashboard updated: score=' + latest.riskScore + ', ' + monthly.length + ' months');
}

// ============================================================
// 3. RENDER RISK CHARTS FROM DATA
// ============================================================
function renderRiskChartsFromData(monthly, annual) {
    var labels = monthly.map(function(m) { return m.month; });
    var scores = monthly.map(function(m) { return m.riskScore; });
    var CR = monthly.map(function(m) { return m.currentRatio; });
    var QR = monthly.map(function(m) { return m.quickRatio; });
    var CASHR = monthly.map(function(m) { return m.cashRatio; });
    var NWC = monthly.map(function(m) { return m.nwc; });
    var NC = monthly.map(function(m) { return m.netCash; });
    var EB = monthly.map(function(m) { return m.ebitda; });
    var ND = monthly.map(function(m) { return m.niDep; });
    var n = labels.length;

    // Monthly Risk Score
    destroyChart('risk_monthly');
    ltChart('risk_monthly','bar',{labels:labels,datasets:[{label:'Risk Score',data:scores,backgroundColor:scores.map(function(v){return RISK_COL[v]||RISK_COL[3];}),borderRadius:6}]},{leg:false,ytick:{stepSize:1,callback:function(v){return 'ระดับ '+v;}}});

    // Yearly Risk Score
    if (annual && annual.length > 0) {
        var YRS = annual.map(function(a) { return a.year; });
        var YRISK = annual.map(function(a) { return a.riskScore; });
        destroyChart('risk_yearly');
        ltChart('risk_yearly','bar',{labels:YRS,datasets:[{label:'Risk Score',data:YRISK,backgroundColor:YRISK.map(function(v){return RISK_COL[v]||RISK_COL[3];}),borderRadius:6}]},{leg:false,ytick:{stepSize:1,callback:function(v){return 'ระดับ '+v;}}});

        // Year Ratios
        var YCR = annual.map(function(a) { return a.currentRatio; });
        var YQR = annual.map(function(a) { return a.quickRatio; });
        var YCASHR = annual.map(function(a) { return a.cashRatio; });
        destroyChart('risk_yrRisk');
        ltChart('risk_yrRisk','bar',{labels:YRS,datasets:[{label:'Risk Score',data:YRISK,backgroundColor:YRISK.map(function(v){return RISK_COL[v]||RISK_COL[3];}),borderRadius:6}]},{leg:false,ytick:{stepSize:1}});
        destroyChart('risk_yrRatio');
        ltChart('risk_yrRatio','line',{labels:YRS,datasets:[
            {label:'Current',data:YCR,borderColor:'#6366f1',borderWidth:2,pointRadius:4,pointBackgroundColor:'#6366f1',fill:false,tension:0.3},
            {label:'Quick',data:YQR,borderColor:'#10b981',borderWidth:2,pointRadius:4,pointBackgroundColor:'#10b981',fill:false,tension:0.3},
            {label:'Cash',data:YCASHR,borderColor:'#f97316',borderWidth:2,pointRadius:4,pointBackgroundColor:'#f97316',fill:false,tension:0.3}
        ]});
    }

    // Ratios
    var benchCR = Array(n).fill(1.5);
    var benchQR = Array(n).fill(1.0);
    var benchCASH = Array(n).fill(0.8);
    destroyChart('risk_ratios');
    ltChart('risk_ratios','line',{labels:labels,datasets:[
        {label:'Current Ratio',data:CR,borderColor:'#6366f1',borderWidth:2.5,pointRadius:5,pointBackgroundColor:'#6366f1',fill:false,tension:0.3},
        {label:'Quick Ratio',data:QR,borderColor:'#10b981',borderWidth:2.5,pointRadius:5,pointBackgroundColor:'#10b981',fill:false,tension:0.3},
        {label:'Cash Ratio',data:CASHR,borderColor:'#f97316',borderWidth:2.5,pointRadius:5,pointBackgroundColor:'#f97316',fill:false,tension:0.3},
        {label:'ค่ากลาง CR 1.5',data:benchCR,borderColor:'rgba(99,102,241,0.4)',borderWidth:1.5,borderDash:[5,4],pointRadius:0,fill:false},
        {label:'ค่ากลาง QR 1.0',data:benchQR,borderColor:'rgba(16,185,129,0.4)',borderWidth:1.5,borderDash:[5,4],pointRadius:0,fill:false},
        {label:'ค่ากลาง CashR 0.8',data:benchCASH,borderColor:'rgba(249,115,22,0.4)',borderWidth:1.5,borderDash:[5,4],pointRadius:0,fill:false}
    ]});

    // NWC
    destroyChart('risk_nwc');
    ltChart('risk_nwc','bar',{labels:labels,datasets:[{label:'NWC (M฿)',data:NWC,backgroundColor:NWC.map(function(v){return v>=0?'rgba(16,185,129,0.8)':'rgba(239,68,68,0.8)';}),borderRadius:6}]},{leg:false});

    // Net Cash
    destroyChart('risk_netcash');
    ltChart('risk_netcash','bar',{labels:labels,datasets:[{label:'เงินบำรุง (M฿)',data:NC,backgroundColor:'rgba(239,68,68,0.7)',borderRadius:6}]},{leg:false});

    // EBITDA
    destroyChart('risk_ebitda');
    ltChart('risk_ebitda','bar',{labels:labels,datasets:[
        {label:'EBITDA',data:EB,backgroundColor:'rgba(16,185,129,0.7)',borderRadius:5},
        {label:'Ni+Dep',data:ND,backgroundColor:'rgba(99,102,241,0.6)',borderRadius:5}
    ]});
}

// ============================================================
// 4. UPDATE ERP OVERVIEW CARD — RISK
// ============================================================
function updateERPOverviewRisk(latest) {
    if (!latest) return;
    var allCards = document.querySelectorAll('#tab-erp-overview .ov-sc');
    var riskCard = null;
    allCards.forEach(function(card) {
        var title = card.querySelector('.st');
        if (title && title.textContent.indexOf('Risk') > -1) riskCard = card;
    });
    if (!riskCard) return;

    var badge = riskCard.querySelector('.sb');
    if (badge) badge.textContent = 'ระดับ ' + latest.riskScore;

    var ring = riskCard.querySelector('.ov-ring');
    if (ring) {
        var pct = Math.round((latest.riskScore / 6) * 100);
        var col = latest.riskScore <= 2 ? '#10b981' : latest.riskScore <= 3 ? '#f59e0b' : '#ef4444';
        ring.style.background = 'conic-gradient(' + col + ' 0% ' + pct + '%, #f1f5f9 ' + pct + '% 100%)';
        var span = ring.querySelector('span');
        if (span) { span.textContent = latest.riskScore; span.style.color = col; }
    }
}

// ============================================================
// 5. HELPERS
// ============================================================
function getRiskLabel(score) {
    var labels = { 1:'ดีมาก', 2:'ดี', 3:'พอใช้', 4:'เสี่ยง', 5:'เสี่ยงสูง', 6:'วิกฤต' };
    return 'ระดับ ' + score + ' = ' + (labels[score] || 'ไม่ระบุ');
}

function getRiskPill(score) {
    if (score <= 2) return '✓ ระดับ ' + score;
    if (score <= 3) return '⚠ ระดับ ' + score;
    return '⚠ ระดับ ' + score + ' เสี่ยง';
}

// ============================================================
// 6. MAIN — แทนที่ renderRiskCharts() เดิม
// ============================================================
function renderRiskCharts() {
    // แสดง hardcoded ทันที
    renderRiskChartsFromData(RISK_FALLBACK.monthly, RISK_FALLBACK.annual);

    // แล้วโหลด live data async
    setTimeout(function() {
        loadRiskFromGAS().catch(function(err) {
            console.error('Risk loadRiskFromGAS error:', err);
        });
    }, 1000);
}
